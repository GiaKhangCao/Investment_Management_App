@if (allocation is null)
{
    <MudSkeleton />
    <MudSkeleton Animation="Animation.False" />
    <MudSkeleton Animation="Animation.Wave" />
} else if (inputData.Length == 0)
{
    <MudText Typo="Typo.h5">There is no assets</MudText>
}
else
{
    <div class="chart-container">
        <MudChart @key="inputData.Length"
                  ChartType="ChartType.Pie"
                  ChartSeries="@inputData.AsChartDataSet()"
                  ChartLabels="@inputLabels"
                  Width="100%"
                  Height="400px"/>
    </div>
}

@code {
    [Parameter] public Allocation? allocation { get; set; }
    private double[] inputData = [];
    private string[] inputLabels = [];

    protected override void OnParametersSet()
    {
        if (allocation is not null)
        {
            inputData = allocation.allocationByType.Values.Select(v => (double)v).ToArray();
            inputLabels = allocation.allocationByType.Keys.ToArray();
        }
    }
}
