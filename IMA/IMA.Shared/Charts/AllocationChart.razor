@inject IDashboard DashboardService

@if (allocation is null)
{
    <MudSkeleton />
    <MudSkeleton Animation="Animation.False" />
    <MudSkeleton Animation="Animation.Wave" />
}
else
{
    <MudChart T="double" ChartType="ChartType.Pie" InputData="@inputData" InputLabels="@inputLabels"/>
}

@code {
    private Allocation? allocation;
    private double[] inputData = [];
    private string[] inputLabels = [];

    protected override async Task OnInitializedAsync()
    {
        allocation = await DashboardService.GetAllocation();
        if (allocation is not null)
        {
            inputData = allocation.allocationByType.Values.Select(v => (double)v).ToArray();
            inputLabels = allocation.allocationByType.Keys.ToArray();
        }
    }
}
