@page "/portfolios"
@using IMA.Shared.Models
@inject IPortfolioService PortfolioService

<PageTitle>Portfolios</PageTitle>

<div class="site-header">
    <MudText Typo="Typo.h4">Portfolios</MudText>
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Add Portfolio</MudButton>
</div>

<MudPaper Class="pa-4" Elevation="0">
    @if (portfolio?.Count == 0)
    {
        <MudText Typo="Typo.h5">No Portfolios Found</MudText>
    }
    else
    {
        <MudTable Items="@(portfolio ?? Enumerable.Range(1, 5).Select(_ => new Portfolio()).ToList())"
                  Loading="@(portfolio == null)"
                  FixedHeader="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Owner</MudTh>
                <MudTh>Invesments</MudTh>
                <MudTh>Total Value</MudTh>
                <MudTh>Created</MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (portfolio == null)
                {
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                } else
                {
                    <MudTd DataLabel="Name">@context.name</MudTd>
                    <MudTd DataLabel="Owner">@context.owner</MudTd>
                    <MudTd DataLabel="Investments">@context.investments.Count().ToString("N2")</MudTd>
                    <MudTd DataLabel="Total Value">@context.investments.Sum(i => i.quantity * i.purchasePrice)</MudTd>
                    <MudTd DataLabel="Created">@context.createdAt.ToString("MMM dd, yyyy")</MudTd>
                }
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 50 , 100 }" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

    @code {
    private List<Portfolio>? portfolio;

    protected override async Task OnInitializedAsync()
    {
        portfolio = await PortfolioService.GetAllAsync();
    }
}
