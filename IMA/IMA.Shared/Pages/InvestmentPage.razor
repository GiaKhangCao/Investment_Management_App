@page "/investments"
@inject IInvestmentService InvestmentService
@inject IDialogService DialogService

<PageTitle>Investments</PageTitle>

<div class="site-header">
    <MudText Typo="Typo.h4">Invesments</MudText>
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">Add Investements</MudButton>
</div>

<MudPaper Class="pa-4" Elevation="0">
    @if (investments?.Count == 0)
    {
        <MudText Typo="Typo.h5">No Investments Found</MudText>
    } else
    {
        <MudTable Items="@(investments ?? Enumerable.Range(1, 5).Select(_ => new Investment()).ToList())"
                Loading="@(investments == null)"
                FixedHeader="true" Striped="true" Hover="true">
            <HeaderContent>
                <MudTh>Ticker</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Portfolio</MudTh>
                <MudTh>QTY</MudTh>
                <MudTh>Purchase Price</MudTh>
                <MudTh>Value</MudTh>
                <MudTh>Date</MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (investments == null)
                {
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                    <MudTd><MudSkeleton /></MudTd>
                } else
                {
                    <MudTd DataLabel="Ticket">@context.ticker</MudTd>
                    <MudTd DataLabel="Type">@context.assetType</MudTd>
                    <MudTd DataLabel="Portfolio">@context.portfolio?.name</MudTd>
                    <MudTd DataLabel="QTY">@context.quantity</MudTd>
                    <MudTd DataLabel="Purchase Price">@context.purchasePrice</MudTd>
                    <MudTd DataLabel="Value">@(context.purchasePrice * context.quantity)</MudTd>
                    <MudTd DataLabel="Date">@context.purchaseDate</MudTd>
                }
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 50, 100}" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

    @code {
    private List<Investment>? investments;

    protected override async Task OnInitializedAsync()
    {
        investments = await InvestmentService.GetAllAsync();
    }

    private async Task OpenAddDialog()
    {
        var dialog = await DialogService.ShowAsync<AddInvestmentDialog>("Add Investment");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Investment newInvestmetn)
        {
            await InvestmentService.AddAsync(newInvestmetn);
            investments = await InvestmentService.GetAllAsync();
        }
    }
}
